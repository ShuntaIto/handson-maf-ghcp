# Copy to .env for local runs (run.py, pytest, `uv run --env-file .env python main.py`).
# The Hosted Agent does not read this file; its settings come from azure.yaml.

# Azure credential used locally (requires `az login`).
AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# Foundry resources. These match the defaults in agent.py.
FOUNDRY_RESOURCE_URL=https://mf-foundry-book.openai.azure.com
FOUNDRY_PROJECT_ENDPOINT=https://mf-foundry-book.services.ai.azure.com/api/projects/first-project
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-6-luna

# Workflow tuning.
# AGENT_TIMEOUT_SECONDS=900
# WORKFLOW_MAX_ITERATIONS=12

# Large tests: override the Hosted Agent endpoint to call.
# HOSTED_AGENT_ENDPOINT=https://mf-foundry-book.services.ai.azure.com/api/projects/first-project/agents/implementation-hypothesis-agent/endpoint/protocols/invocations?api-version=v1
